# Slim API image — Django + DRF + Gunicorn. Never installs TensorFlow/torch.
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt /app/
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements-api.txt

COPY . /app/

RUN SECRET_KEY=dummy-key-for-building-only \
    DATABASE_URL= \
    DEBUG=True \
    python manage.py collectstatic --noinput || true

EXPOSE 8000

CMD ["sh", "-c", "gunicorn AgriProject.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers ${GUNICORN_WORKERS:-2} --timeout 60"]
