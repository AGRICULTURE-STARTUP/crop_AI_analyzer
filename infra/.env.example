# Copy to infra/.env and fill in secrets. Never commit the real .env.
#   cp .env.example .env && chmod 600 .env

# --- Postgres ---
POSTGRES_USER=agriscan
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=agriscan

# --- Django ---
SECRET_KEY=change-me-django-secret-key
DEBUG=False
# Local laptop testing: True relaxes CORS, SSL redirect, hosts, throttles.
# MUST be False on Contabo production.
DEV_ENV=False
ALLOW_LEGACY_PARTNER_KEYS=false
# JWT and browser sessions expire after this many idle seconds.
SESSION_IDLE_TIMEOUT_SECONDS=1800
# REQUIRED in production. Comma-separated hostnames; the API refuses to boot
# when this is empty. No wildcards: a wildcard ALLOWED_HOSTS lets a forged
# Host header poison password-reset links.
ALLOWED_HOSTS=api.agriscan.co.ke

# --- Transport security ---
# HSTS defaults to 0 (off). Only set it once TLS is confirmed working on the
# real hostname — browsers cache max-age and it is hard to undo.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# Comma-separated Vercel + production origins
CORS_ALLOWED_ORIGINS=https://agriscan.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://agriscan.vercel.app,https://api.agriscan.example.com

# Assembled by Compose for containers; set for local non-Compose runs:
# DATABASE_URL=postgres://agriscan:change-me-strong-password@localhost:5432/agriscan
DB_SSL_REQUIRE=false
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Knowledge-base PDFs for the RAG worker. Optional: when unset the app probes
# apps/api/Data then apps/api/data (git stores the PDFs under Data/ and the
# KAMIS cache under data/, which collide on macOS/Windows but not on Linux).
# KB_DATA_DIR=/app/Data

# --- Inference knobs (8 GB Contabo) ---
MAX_LOADED_CROP_MODELS=2
RERANKER_ENABLED=false
MODELS_DIR=/models
SCAN_IMAGES_ROOT=/app/scan_images
GUNICORN_WORKERS=2
MAX_QUEUED_SCAN_JOBS=20

# --- External services ---
GROQ_API_KEY=
TAVILY_API_KEY=
OPEN_WEATHER_API_KEY=
HF_MODEL_REPO_ID=jobcode12/CropModels
HF_MODEL_REVISION=main
HF_TOKEN=
CLOUDINARY_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENDGRID_API_KEY=
EMAIL_HOST_USER=apikey
DEFAULT_FROM_EMAIL=

# --- M-Pesa (Daraja) ---
# The code accepts MPESA_CONSUMER_* or the bare CONSUMER_* names.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Required for live. Left blank, sandbox falls back to 174379 + the public
# sandbox passkey so laptop testing works with no Daraja account.
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.agriscan.co.ke/mpesa/callback/
# sandbox | live. "live" picks api.safaricom.co.ke and refuses to fall back to
# the sandbox shortcode or passkey.
MPESA_ENV=sandbox
# Optional: override the Daraja host entirely.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# Optional comma-separated IPs/CIDRs; empty = allow all. Ignored when DEV_ENV=True.
MPESA_CALLBACK_ALLOWLIST=

# --- USSD / SMS gateway (wire when live credentials arrive) ---
# simulate | africastalking | twilio | textsms
USSD_PROVIDER=simulate
USSD_SERVICE_CODE=*384*55#
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
TWILIO_AUTH_TOKEN=
TEXTSMS_API_KEY=
# Provider webhook → POST /api/v1/ussd/
# Optional shared secret header: X-AgriScan-USSD-Secret
