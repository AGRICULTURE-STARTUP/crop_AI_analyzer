# Copy to infra/.env and fill in secrets. Never commit the real .env.
#   cp .env.example .env && chmod 600 .env

# --- Postgres ---
POSTGRES_USER=agriscan
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=agriscan

# --- Django ---
SECRET_KEY=change-me-django-secret-key
DEBUG=False
ALLOWED_HOSTS=api.agriscan.example.com,localhost,127.0.0.1
# Comma-separated Vercel + production origins
CORS_ALLOWED_ORIGINS=https://agriscan.vercel.app,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://agriscan.vercel.app,https://api.agriscan.example.com

# Assembled by Compose for containers; set for local non-Compose runs:
# DATABASE_URL=postgres://agriscan:change-me-strong-password@localhost:5432/agriscan
DB_SSL_REQUIRE=false
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Inference knobs (8 GB Contabo) ---
MAX_LOADED_CROP_MODELS=2
RERANKER_ENABLED=false
MODELS_DIR=/models
GUNICORN_WORKERS=2
MAX_QUEUED_SCAN_JOBS=20

# --- External services ---
GROQ_API_KEY=
TAVILY_API_KEY=
OPEN_WEATHER_API_KEY=
HF_MODEL_REPO_ID=
CLOUDINARY_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENDGRID_API_KEY=
EMAIL_HOST_USER=apikey
DEFAULT_FROM_EMAIL=

# --- M-Pesa (Daraja) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.agriscan.example.com/mpesa/callback/
MPESA_ENV=sandbox
